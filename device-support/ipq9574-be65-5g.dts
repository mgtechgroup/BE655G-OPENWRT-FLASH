/*
 * Device tree for BE65-5G (Qualcomm IPQ9574 AL02-C11)
 *
 * Wi-Fi 7 router: 1× IPQ9574 integrated 2.4 GHz + 3× QCN9224 (PCIe)
 * Ethernet: 4× QCA8084 QSGMII (PPE ports 1-4), eth0=WAN, eth1-4=LAN
 * Storage:  QSPI NAND (UBI rootfs) + SPI NOR (u-boot/env)
 * Console:  115200n8 on GPIO34/GPIO35 (BLSP1_UART2)
 *
 * Copyright (c) The Linux Foundation and contributors
 */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/leds/common.h>
#include "ipq9574-rdp-common.dtsi"

/ {
	model = "BE65-5G";
	compatible = "qcom,ipq9574-ap-al02-c11", "qcom,ipq9574";

	aliases {
		serial0   = &blsp1_uart2;
		led-boot  = &led_status_green;
		led-failsafe = &led_status_red;
		led-running  = &led_status_green;
		led-upgrade  = &led_status_blue;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	gpio-keys {
		compatible = "gpio-keys";

		reset {
			label = "reset";
			gpios = <&tlmm 45 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_RESTART>;
			debounce-interval = <60>;
		};

		wps {
			label = "wps";
			gpios = <&tlmm 43 GPIO_ACTIVE_LOW>;
			linux,code = <KEY_WPS_BUTTON>;
			debounce-interval = <60>;
		};
	};

	leds {
		compatible = "gpio-leds";

		led_status_red: red {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_RED>;
			gpios = <&tlmm 52 GPIO_ACTIVE_HIGH>;
		};

		led_status_green: green {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&tlmm 51 GPIO_ACTIVE_HIGH>;
		};

		led_status_blue: blue {
			function = LED_FUNCTION_STATUS;
			color = <LED_COLOR_ID_BLUE>;
			gpios = <&tlmm 50 GPIO_ACTIVE_HIGH>;
		};

		wlan2g {
			function = LED_FUNCTION_WLAN;
			color = <LED_COLOR_ID_GREEN>;
			gpios = <&tlmm 64 GPIO_ACTIVE_HIGH>;
			linux,default-trigger = "phy0tpt";
		};
	};
};

/* ── UART ───────────────────────────────────────────────── */
&blsp1_uart2 {
	pinctrl-0 = <&uart2_pins>;
	pinctrl-names = "default";
	status = "okay";
};

/* ── SPI NOR (u-boot + env on NOR, inherited from rdp-common.dtsi) */
/* rdp-common provides blsp1_spi0 with jedec,spi-nor — no override needed */

/* ── QSPI NAND (UBI rootfs) ──────────────────────────��─── */
&qpic_nand {
	pinctrl-0 = <&qpic_nand_default>;
	pinctrl-names = "default";
	status = "okay";

	nand@0 {
		reg = <0>;
		nand-ecc-engine = <&qpic_nand>;
		nand-ecc-strength = <4>;
		nand-ecc-step-size = <512>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			/* training / bbt reserved by Qualcomm SBL */
			partition@0 {
				label = "0:training";
				reg = <0x0 0x80000>;
				read-only;
			};

			partition@80000 {
				label = "0:license";
				reg = <0x80000 0x40000>;
				read-only;
			};

			/* dual-bank rootfs for failsafe upgrades */
			partition@c0000 {
				label = "rootfs";
				reg = <0xc0000 0x3c00000>;
			};

			partition@3cc0000 {
				label = "rootfs_1";
				reg = <0x3cc0000 0x3c00000>;
			};
		};
	};
};

/* ── I2C (expansion) ───────────────────────────────────── */
&blsp1_i2c3 {
	pinctrl-0 = <&i2c3_pins>;
	pinctrl-names = "default";
	status = "okay";
};

/* ── USB 3.0 ────────────────────────────────────────────── */
&usb_0_dwc3 {
	dr_mode = "host";
};

&usb_0_qmpphy {
	vdda-pll-supply = <&mp5496_l5>;
	vdda-phy-supply = <&regulator_fixed_0p925>;
	status = "okay";
};

&usb_0_qusbphy {
	vdd-supply = <&regulator_fixed_0p925>;
	vdda-pll-supply = <&mp5496_l5>;
	vdda-phy-dpdm-supply = <&regulator_fixed_3p3>;
	status = "okay";
};

&usb3 {
	status = "okay";
};

/* ── PCIe (3× QCN9224 Wi-Fi 7 cards) ───────────────────── */
&pcie1 {
	pinctrl-0 = <&pcie1_default>;
	pinctrl-names = "default";
	perst-gpios = <&tlmm 26 GPIO_ACTIVE_LOW>;
	wake-gpios  = <&tlmm 27 GPIO_ACTIVE_LOW>;
	status = "okay";
};
&pcie1_phy { status = "okay"; };

&pcie2 {
	pinctrl-0 = <&pcie2_default>;
	pinctrl-names = "default";
	perst-gpios = <&tlmm 29 GPIO_ACTIVE_LOW>;
	wake-gpios  = <&tlmm 30 GPIO_ACTIVE_LOW>;
	status = "okay";
};
&pcie2_phy { status = "okay"; };

&pcie3 {
	pinctrl-0 = <&pcie3_default>;
	pinctrl-names = "default";
	perst-gpios = <&tlmm 32 GPIO_ACTIVE_LOW>;
	wake-gpios  = <&tlmm 33 GPIO_ACTIVE_LOW>;
	status = "okay";
};
&pcie3_phy { status = "okay"; };

/* ── MDIO + QCA8084 4-port PHY package ──────────────────── */
&mdio {
	pinctrl-0 = <&mdio_pins>;
	pinctrl-names = "default";
	reset-gpios = <&tlmm 60 GPIO_ACTIVE_LOW>;
	clock-frequency = <6250000>;
	status = "okay";

	/* QCA8084 quad-port 1G PHY — QSGMII bundle on PCS0 */
	ethernet-phy-package@1 {
		compatible = "qcom,qca8084-package";
		#address-cells = <1>;
		#size-cells = <0>;
		reg = <1>;

		/* PCS0 = QSGMII MAC mode (4×1G toward PPE), PCS1 unused */
		qcom,package-mode = <1>;

		phy0: ethernet-phy@1 { reg = <1>; };
		phy1: ethernet-phy@2 { reg = <2>; };
		phy2: ethernet-phy@3 { reg = <3>; };
		phy3: ethernet-phy@4 { reg = <4>; };
	};
};

/* ── PPE Ethernet ports ───────────────────────────���─────── */
/* eth0=WAN (port1), eth1-4=LAN (port2-4) */
&qcom_ppe {
	ethernet-ports {
		#address-cells = <1>;
		#size-cells = <0>;

		xgmac1: port@1 {
			reg = <1>;
			label = "wan";
			phy-mode = "qsgmii";
			managed = "in-band-status";
			phy-handle = <&phy0>;
			pcs-handle = <&pcs0_ch0>;
			local-mac-address = [00 00 00 00 00 00];
			clocks = <&nsscc NSS_CC_PORT1_MAC_CLK>,
				 <&nsscc NSS_CC_PORT1_RX_CLK>,
				 <&nsscc NSS_CC_PORT1_TX_CLK>;
			clock-names = "port_mac", "port_rx", "port_tx";
			resets = <&nsscc PORT1_MAC_ARES>,
				 <&nsscc PORT1_RX_ARES>,
				 <&nsscc PORT1_TX_ARES>;
			reset-names = "port_mac", "port_rx", "port_tx";
		};

		xgmac2: port@2 {
			reg = <2>;
			label = "lan1";
			phy-mode = "qsgmii";
			managed = "in-band-status";
			phy-handle = <&phy1>;
			pcs-handle = <&pcs0_ch1>;
			local-mac-address = [00 00 00 00 00 00];
			clocks = <&nsscc NSS_CC_PORT2_MAC_CLK>,
				 <&nsscc NSS_CC_PORT2_RX_CLK>,
				 <&nsscc NSS_CC_PORT2_TX_CLK>;
			clock-names = "port_mac", "port_rx", "port_tx";
			resets = <&nsscc PORT2_MAC_ARES>,
				 <&nsscc PORT2_RX_ARES>,
				 <&nsscc PORT2_TX_ARES>;
			reset-names = "port_mac", "port_rx", "port_tx";
		};

		xgmac3: port@3 {
			reg = <3>;
			label = "lan2";
			phy-mode = "qsgmii";
			managed = "in-band-status";
			phy-handle = <&phy2>;
			pcs-handle = <&pcs0_ch2>;
			local-mac-address = [00 00 00 00 00 00];
			clocks = <&nsscc NSS_CC_PORT3_MAC_CLK>,
				 <&nsscc NSS_CC_PORT3_RX_CLK>,
				 <&nsscc NSS_CC_PORT3_TX_CLK>;
			clock-names = "port_mac", "port_rx", "port_tx";
			resets = <&nsscc PORT3_MAC_ARES>,
				 <&nsscc PORT3_RX_ARES>,
				 <&nsscc PORT3_TX_ARES>;
			reset-names = "port_mac", "port_rx", "port_tx";
		};

		xgmac4: port@4 {
			reg = <4>;
			label = "lan3";
			phy-mode = "qsgmii";
			managed = "in-band-status";
			phy-handle = <&phy3>;
			pcs-handle = <&pcs0_ch3>;
			local-mac-address = [00 00 00 00 00 00];
			clocks = <&nsscc NSS_CC_PORT4_MAC_CLK>,
				 <&nsscc NSS_CC_PORT4_RX_CLK>,
				 <&nsscc NSS_CC_PORT4_TX_CLK>;
			clock-names = "port_mac", "port_rx", "port_tx";
			resets = <&nsscc PORT4_MAC_ARES>,
				 <&nsscc PORT4_RX_ARES>,
				 <&nsscc PORT4_TX_ARES>;
			reset-names = "port_mac", "port_rx", "port_tx";
		};
	};
};

/* ── RPM regulators (same as Kiwi-DVK) ─────────────────── */
&rpm_requests {
	regulators {
		compatible = "qcom,rpm-mp5496-regulators";
		ipq9574_s1: s1 {
			regulator-min-microvolt = <725000>;
			regulator-max-microvolt = <1075000>;
		};
		mp5496_l5: l5 {
			regulator-min-microvolt = <1800000>;
			regulator-max-microvolt = <1800000>;
			regulator-always-on;
			regulator-boot-on;
		};
	};
};

/* ── Clock tree ────────────────────────���────────────────── */
&ref_48mhz_clk {
	clock-div = <1>;
	clock-mult = <1>;
};

&xo_board_clk {
	clock-div = <2>;
	clock-mult = <1>;
};

&xo_clk {
	clock-frequency = <48000000>;
};

&sleep_clk {
	clock-frequency = <32000>;
};

/* ── Pin control ────────────────────────────────────────── */
&tlmm {
	/* PCIe perst/wake pins */
	pcie1_default: pcie1-default-state {
		perst-pins {
			pins = "gpio26";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
			output-low;
		};
		wake-pins {
			pins = "gpio27";
			function = "pcie1_wake";
			drive-strength = <6>;
			bias-pull-up;
		};
		clkreq-pins {
			pins = "gpio25";
			function = "pcie1_clk";
			drive-strength = <6>;
			bias-pull-up;
		};
	};

	pcie2_default: pcie2-default-state {
		perst-pins {
			pins = "gpio29";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-down;
			output-low;
		};
		wake-pins {
			pins = "gpio30";
			function = "pcie2_wake";
			drive-strength = <6>;
			bias-pull-up;
		};
		clkreq-pins {
			pins = "gpio28";
			function = "pcie2_clk";
			drive-strength = <6>;
			bias-pull-up;
		};
	};

	pcie3_default: pcie3-default-state {
		perst-pins {
			pins = "gpio32";
			function = "gpio";
			drive-strength = <8>;
			bias-pull-up;
			output-low;
		};
		wake-pins {
			pins = "gpio33";
			function = "pcie3_wake";
			drive-strength = <6>;
			bias-pull-up;
		};
		clkreq-pins {
			pins = "gpio31";
			function = "pcie3_clk";
			drive-strength = <6>;
			bias-pull-up;
		};
	};

	mdio_pins: mdio-pins {
		mdc  { pins = "gpio38"; function = "mdc";  drive-strength = <8>; bias-disable; };
		mdio { pins = "gpio39"; function = "mdio"; drive-strength = <8>; bias-pull-up; };
	};

	qpic_nand_default: qpic-nand-default-state {
		clk  { pins = "gpio5"; function = "qspi_clk"; drive-strength = <8>; bias-disable; };
		cs   { pins = "gpio4"; function = "qspi_cs";  drive-strength = <8>; bias-disable; };
		data { pins = "gpio0", "gpio1", "gpio2", "gpio3"; function = "qspi_data"; drive-strength = <8>; bias-disable; };
	};

	i2c3_pins: i2c3-pins {
		pins = "gpio15", "gpio16";
		function = "blsp3_i2c";
		drive-strength = <8>;
		bias-disable;
	};
};
